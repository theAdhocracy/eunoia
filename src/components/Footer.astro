<style>
	footer {
		--border-width: 2px;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		padding: 0 1rem;
		border-block-start: 2px solid var(--colour-border);
		background-color: var(--colour-white);
		font-size: 0.75rem;
		font-family: var(--font-alt);
		color: var(--colour-text-faded);

		nav a,
		p {
			padding-block: 1rem;
		}

		nav {
			letter-spacing: 0.05em;

			a {
				display: inline-block;
				color: var(--colour-text-faded);
				text-decoration: none;

				&:hover,
				&:focus {
					color: var(--colour-focus);
					border-block-start: 2px solid var(--colour-focus);
					margin-block-start: -2px;
					outline: none;
				}
			}
		}
	}
</style>
