---
import Announcements from "./Announcements.astro";
import Arrow from "../assets/ArrowIcon.svg";
---

<header>
	<section class="account-settings">
		<form>
			<label for="date-picker">date</label>
			<input
				type="date"
				id="date-picker"
				name="date-picker"
				value=""
				min="2009-01-01"
				max="2009-12-31"
			/>
			<button type="submit">
				<span class="sr-only">Set date</span><Arrow />
			</button>
		</form>
		<form>
			<label for="theme-picker">theme</label>
			<select id="theme-picker" name="theme-picker">
				<option value="classic" selected>classic</option>
				<option value="a11y">accessible</option>
			</select>
			<button type="submit">
				<span class="sr-only">Set theme</span><Arrow />
			</button>
		</form>
	</section>
	<a href="/"><img src="/images/logo.jpg" alt="Beautiful thinking" /></a>
	<nav>
		<ul role="list">
			<li><a href="/">home</a></li>
			<li><a href="/photos">photo gallery</a></li>
			<li><a href="/about">about us</a></li>
			<li><a href="/thoughts">thoughts</a></li>
			<li><a href="/thoughts">timeline</a></li>
		</ul>
		<div class="location">
			<p>
				Location: <span class="skeleton">Loading...</span>
				<noscript>Cumbria, United Kingdom</noscript>
			</p>
			<img src="/images/maps/uk.png" alt="" />
		</div>
		<p class="callout">round the world</p>
	</nav>
	<Announcements />
</header>

<style>
	header {
		display: flex;
		flex-direction: column;
		background-color: var(--colour-grey-lighter);

		& > a:has(img) {
			width: 100%;
			background-color: #073950;

			img {
				margin-inline: auto;
			}
		}

		nav {
			align-self: center;

			display: flex;
			flex-wrap: wrap;
			min-height: 60px;
			width: 100%;
			max-width: var(--width-content);
		}

		ul[role="list"] {
			flex: 1 1 58%;

			--gutter: 0.5rem 2rem;
			padding: 1rem clamp(1.5rem, 5vw + 1rem, 5rem);
			place-content: center;
			font-size: 0.9rem;

			li {
				display: flex;
				align-items: center;
			}

			a {
				place-self: center;
				text-decoration: none;
				font-weight: bold;
			}

			a:hover,
			a:focus {
				color: var(--colour-focus);
				outline-color: var(--colour-focus);
			}

			a:focus-visible {
				--border-offest: 0.1rem;

				outline: none;
				margin-block: calc(var(--border-offest) * -1);
				padding-block: var(--border-offest);
				border-block: 2px solid var(--colour-focus);
			}
		}

		.location {
			flex: 1 1 max-content;
			min-height: 60px;

			display: flex;
			flex-wrap: wrap;
			font-family: var(--font-alt);
			background-color: var(--colour-grey-light);
			font-size: 0.7rem;
			font-style: italic;
			padding-block: 0.25rem;
			padding-inline: 2em;
			text-align: center;
			place-items: center;
			place-content: center;

			p {
				max-width: 20ch;
				margin: 0;
				line-height: 1.4;
			}

			img {
				margin-inline-start: 1em;
				width: auto;
				max-height: 3rem;
			}
		}

		.callout {
			flex: 1 1 auto;
			min-height: 60px;

			margin: 0;
			padding-inline: 2em;
			place-content: center;
			background-color: var(--colour-orange);
			color: var(--colour-text-inverse);
			font-size: 0.75rem;
			text-align: center;
		}

		.account-settings {
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem 3rem;
			padding-block: 0.25rem;
			padding-inline: 1rem;
			background-color: var(--colour-white);
			border-block-end: var(--border);

			justify-content: end;

			form {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				font-size: 0.8rem;

				label {
					min-width: max-content;
					color: var(--colour-grey-dark);
				}

				input,
				select {
					min-height: 1.75rem;
				}

				button {
					background: none;
					border: none;
					padding: 0;
					margin: 0;

					display: flex;
					place-items: center;

					svg {
						fill: var(--colour-grey-dark);
					}

					&:hover svg,
					&:focus svg {
						fill: var(--colour-focus);
					}
				}
			}
		}
	}
</style>

<script>
	// Data: maps for different date ranges
	// TODO: Add in city dates (only have country so far e.g. Kuala Kumpur, Malaysia <-- known from orphaned Header copy)
	const maps = [
		{
			location: "Cumbria, United Kingdom",
			src: "/images/maps/uk.png",
			from: new Date("2009-01-01"),
			to: new Date("2009-02-02"),
		},
		{
			location: "JFK, United States",
			src: "/images/maps/na.png",
			from: new Date("2009-02-03"),
			to: new Date("2009-02-03"),
		},
		{
			location: "St. Maarten, West Indies",
			src: "/images/maps/carib.png",
			from: new Date("2009-02-04"),
			to: new Date("2009-03-23"),
		},
		{
			location: "New York, United States",
			src: "/images/maps/na.png",
			from: new Date("2009-03-23"),
			to: new Date("2009-03-26"),
		},
		{
			location: "LAX, United States",
			src: "/images/maps/na.png",
			from: new Date("2009-03-27"),
			to: new Date("2009-03-27"),
		},
		{
			location: "T.A.R.D.I.S, Outside Time",
			src: "/images/maps/tardis.png",
			from: new Date("2009-03-28"),
			to: new Date("2009-03-28"),
		},
		{
			location: "Auckland, New Zealand",
			src: "/images/maps/kiwi.png",
			from: new Date("2009-03-29"),
			to: new Date("2009-04-25"),
		},
		{
			location: "Sydney, Australia",
			src: "/images/maps/oz.png",
			from: new Date("2009-04-26"),
			to: new Date("2009-06-04"),
		},
		{
			location: "Singapore, SE Asia",
			src: "/images/maps/seasia.png",
			from: new Date("2009-06-05"),
			to: new Date("2009-06-25"),
		},
		{
			location: "Cape Town, South Africa",
			src: "/images/maps/safriq.png",
			from: new Date("2009-06-26"),
			to: new Date("2009-07-17"),
		},
	];

	// Function: update selected date (date picker)
	const updateDatePicker = (date: string) => {
		if (date) {
			body.dataset.date = date.toString();
			sessionStorage.setItem("date", date);
		}
	};

	// Function: update selected theme (theme picker)
	const updateThemePicker = (theme: string) => {
		if (theme) {
			body.dataset.theme = theme;
			themePicker.value = theme;
			localStorage.setItem("theme", theme);
		}
	};

	// Function: Update map based on selected date
	const updateMap = (date: Date, maps: any[], location: HTMLElement) => {
		// Find the map for the selected date
		const map =
			maps.find((m) => date >= new Date(m.from) && date <= new Date(m.to)) ||
			maps[0];

		// Update the location text
		const locationText = location.querySelector("p");
		if (locationText) {
			locationText.textContent = `Location: ${map.location}`;
		}

		// Update the map image
		const mapImage = location.querySelector("img");
		if (mapImage) {
			mapImage.src = map.src;
		}
	};

	// Get DOM elements
	const body = document.body;
	const location = document.querySelector("header .location") as HTMLElement;
	const datePicker = document.getElementById("date-picker") as HTMLInputElement;
	const themePicker = document.getElementById(
		"theme-picker"
	) as HTMLSelectElement;
	const datePickerButton = datePicker?.nextElementSibling as HTMLButtonElement;
	const themePickerButton =
		themePicker?.nextElementSibling as HTMLButtonElement;

	// ** Initial state **

	// Event: initial page load
	window.addEventListener("load", () => {
		// Set the current site date (based on date picker)
		const todayAgo = new Date().toString().replace(/^[0-9]{4}-/, "2009-"); // Today's date in 2009 (for date picker default)
		const date = sessionStorage.getItem("date") || todayAgo;
		if (datePicker) datePicker.value = date;
		updateDatePicker(date);

		// Set current theme (based on local storage or theme picker)
		const themeSelected = themePicker?.value;
		const theme = localStorage.getItem("theme") || themeSelected;
		updateThemePicker(theme);

		// Determine current map based on selected date
		updateMap(new Date(todayAgo), maps, location);
	});

	// ** Date picker **

	// Event: date changed via input
	datePicker?.addEventListener("change", (event) => {
		const date = (event.target as HTMLInputElement).value;
		updateDatePicker(date);
	});

	// Event: date changed via button
	datePickerButton?.addEventListener("click", (event) => {
		event.preventDefault();
		const date = datePicker?.value;
		updateDatePicker(date);
	});

	// ** Theme picker **

	// Event: theme changed via select
	themePicker?.addEventListener("change", (event) => {
		const theme = (event.target as HTMLInputElement).value;
		updateThemePicker(theme);
	});

	// Event: theme changed via button
	themePickerButton?.addEventListener("click", (event) => {
		event.preventDefault();
		const theme = themePicker?.value;
		updateThemePicker(theme);
	});

	// ** Mutations **

	// Mutation: Listen for changes in the data-date attribute and update map accordingly
	const dateObserver = new MutationObserver((mutationsList) => {
		mutationsList.forEach((mutation) => {
			if (mutation.type === "attributes") {
				if (mutation.attributeName === "data-date") {
					if (body.dataset.date) {
						updateMap(new Date(body.dataset.date), maps, location);
					}
					// TODO: Fetch new thoughts data for the selected date
					// Unsure exactly how to do this, but it should be possible to get Astro to build a folder of JSON files for each thought, and retrieve them that way. Not quite an API, but similar, and should work statically via a fetch request.
					// May be worth moving this into a separate script file and calling into the head.
					// Also consider removing the default data e.g. map and thoughts until a date is selected; loading spinners may be preferable.
				}
			}
		});
	});

	// Attach mutations to relevant elements
	dateObserver.observe(body, { attributes: true });
</script>
