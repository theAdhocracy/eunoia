---
import Announcements from "./Announcements.astro";
---

<header>
	<img src="/images/logo.jpg" alt="Beautiful thinking" />
	<nav>
		<ul role="list">
			<li><a href="/">home</a></li>
			<li><a href="/photos">photo gallery</a></li>
			<li><a href="/about">about us</a></li>
			<li><a href="/thoughts">thoughts</a></li>
			<li><a href="/thoughts">timeline</a></li>
		</ul>
		<div class="location">
			<p>Location: Cumbria, United Kingdom</p>
			<!-- TODO: create a map for Cumbria (and also probably New York, can use NA for LA) -->
			<img
				src="/images/maps/safriq.png"
				alt="Map outline of the county Cumbria"
			/>
		</div>
		<p class="callout">round the world</p>
	</nav>
	<Announcements />
</header>

<!-- TODO: move some of this style into global sheets, fix the existing styles (remove most), and use tokens -->
<style>
	header {
		display: flex;
		flex-direction: column;
		background-color: var(--colour-blue-darker);

		& > img {
			place-self: center;
		}

		nav {
			display: flex;
			flex-wrap: wrap;
			min-height: 60px;
			background-color: var(--colour-grey-lighter);
		}

		ul[role="list"] {
			flex: 1 1 58%;

			--gutter: 0.5rem 2rem;
			padding: 1rem clamp(1.5rem, 5vw + 1rem, 5rem);

			font-size: 0.9rem;

			li {
				display: flex;
				align-items: center;
			}

			a {
				place-self: center;
				text-decoration: none;
				font-weight: bold;
			}

			a:hover,
			a:focus {
				color: var(--colour-focus);
				outline-color: var(--colour-focus);
			}

			a:focus-visible {
				--border-offest: 0.1rem;

				outline: none;
				margin-block: calc(var(--border-offest) * -1);
				padding-block: var(--border-offest);
				border-block: 2px solid var(--colour-focus);
			}
		}

		.location {
			flex: 1 1 max-content;
			min-height: 60px;

			display: flex;
			flex-wrap: wrap;
			font-family: var(--font-alt);
			background-color: var(--colour-grey-light);
			font-size: 0.7rem;
			font-style: italic;
			padding-block: 0.25rem;
			padding-inline: 2em;
			text-align: center;
			place-items: center;
			place-content: center;

			p {
				max-width: 20ch;
				margin: 0;
				line-height: 1.4;
			}

			img {
				margin-inline-start: 1em;
				width: auto;
				max-height: 3rem;
			}
		}

		.callout {
			flex: 1 1 auto;
			min-height: 60px;

			margin: 0;
			padding-inline: 2em;
			place-content: center;
			background-color: var(--colour-orange);
			color: var(--colour-text-inverse);
			font-size: 0.75rem;
			text-align: center;
		}
	}
</style>
