---
import Arrow from "../assets/ArrowIcon.svg";
import { formatDate } from "../utilities/formatDate";

// Latest Thought
// TODO: Fetch thoughts based on collection published date and current date, adjusted for year. Should update in "real time". Can be random instead if that is too hard.
const latestThought = {
	id: "001",
	author: "Murray",
	handle: "@gnortherngnome",
	content:
		"Some random thought that we said once 😛 And then there was some more. Up to 120 characters, at the time.",
	date: "2009-05-13T12:45",
};

const thoughtDate = formatDate(latestThought.date);

// Latest Photo
// TODO: Fetch a random photo. Bonus points if it can only be ones that would have been uploaded by that date.
const photo = {
	src: "/images/avatars/mike.jpg",
	alt: "Placeholder image for photo of the day",
	caption: "Mike looking off into the middle distance",
};
---

<aside class="sidebar" data-layout="content">
	<search role="search" aria-labelledby="search-label">
		<!-- TODO: Add search logic -->
		<form>
			<label id="search-label" for="search">search</label>
			<input
				id="search"
				type="search"
				inputmode="search"
				autocomplete="off"
				placeholder="Type here..."
			/>
			<button type="submit">
				<span class="sr-only">Submit</span>
				<Arrow />
			</button>
		</form>
	</search>
	<section class="social-widget">
		<h2>Latest Thought</h2>
		<article>
			<p>{latestThought.content}</p>
			<footer data-layout="content">
				<p>
					<a href={`/thoughts#${latestThought.id}`}>
						{latestThought.author}
						({latestThought.handle})
						<span><Arrow /></span>
					</a>
				</p>
				<p>
					<time datetime={thoughtDate.html}>
						{thoughtDate.datetime}
					</time>
				</p>
			</footer>
		</article>
	</section>
	<section class="photo-widget">
		<h2>Photo of the Day</h2>
		<figure>
			<img src={photo.src} alt={photo.alt} width="300" height="200" />
			<figcaption>
				{photo.caption && <p>{photo.caption}</p>}
				<a href="/photos">Gallery <Arrow /></a>
			</figcaption>
		</figure>
	</section>
	<nav class="archives" aria-labelledby="archives-label">
		<!-- TODO: Implement correct hash links -->
		<h2 id="archives-label">Archives</h2>
		<ol role="list">
			<li>
				<a href="/timeline#august">
					<Arrow />
					August 2009
				</a>
			</li>
			<li>
				<a href="/timeline#july">
					<Arrow />
					July 2009
				</a>
			</li>
			<li>
				<a href="/timeline#june">
					<Arrow />
					June 2009
				</a>
			</li>
			<li>
				<a href="/timeline#may">
					<Arrow />
					May 2009
				</a>
			</li>
			<li>
				<a href="/timeline#april">
					<Arrow />
					April 2009
				</a>
			</li>
			<li>
				<a href="/timeline#march">
					<Arrow />
					March 2009
				</a>
			</li>
			<li>
				<a href="/timeline#february">
					<Arrow />
					February 2009
				</a>
			</li>
		</ol>
	</nav>
</aside>

<style>
	.sidebar {
		--gutter: 0;

		padding: 1rem;
		background-color: var(--colour-grey-light);

		h2 {
			font-size: 1rem;
			margin-block-end: 0.5em;
		}

		a:hover,
		a:focus {
			color: var(--colour-focus);
		}
	}

	search {
		background-color: var(--colour-grey-light);

		form {
			display: flex;
			flex-wrap: wrap;
			gap: 1.5rem;
			align-content: center;
			align-items: center;
			max-inline-size: max-content;
			margin-inline: auto;
			padding-block-end: 1rem;

			label {
				font-weight: bold;
				color: var(--colour-white);
				text-shadow: 0 0 1px var(--colour-grey-dark);
				filter: drop-shadow(1px 1px 1px rgba(0 0 0 / 0.2));
			}

			input {
				flex-basis: 1 1 auto;
				width: clamp(10ch, 60%, 25ch);
				border: var(--border-form);
				background-color: var(--colour-white);
			}

			button {
				display: flex;
				align-items: center;
				background-color: transparent;
				border: none;
			}

			label,
			button {
				margin-block-start: -1px;
			}

			svg {
				margin-inline-start: -0.25rem;
				fill: var(--colour-grey-dark);
			}
		}
	}

	.social-widget {
		margin-inline: -1rem;
		padding: 1.5rem 1rem;
		background-color: var(--colour-blue-mid);
		color: var(--colour-blue-light);

		h2 {
			color: inherit;
			margin-block-end: 1rem;
		}

		article {
			max-width: fit-content;
			margin-inline: auto;
		}

		article > p:first-of-type {
			font-size: 0.9rem;
			max-width: 39ch;
		}

		a:has(span) {
			display: flex;
			align-items: center;
			justify-content: end;
			gap: 0.25rem;

			span {
				max-block-size: 1em;
			}
		}

		footer {
			--gutter: 0;

			margin-block-start: 1rem;
			text-align: end;
			font-size: 0.8rem;

			a {
				text-decoration: none;
				color: inherit;
			}

			time {
				color: var(--colour-white);
			}
		}
	}

	.photo-widget {
		margin-inline: -1rem;
		padding-inline: 1rem;
		padding-block: 1rem;
		background-color: var(--colour-blue-light);
		color: var(--colour-blue-mid);

		h2 {
			color: inherit;
			margin-block-end: 1rem;
		}

		figure {
			max-inline-size: fit-content;
			margin: 0;
			margin-inline: auto;
		}

		img {
			border: 2px solid var(--colour-border);
		}

		figcaption {
			padding: 0.25rem;
			font-size: 0.8rem;

			p {
				text-align: center;
				margin-block-end: 0.5rem;
			}

			a:has(svg) {
				display: flex;
				align-items: center;
				justify-content: end;
				gap: 0.25rem;
				text-decoration: none;
			}
		}
	}

	.archives {
		padding-block: 1rem;

		ol {
			--gutter: 0;

			flex-direction: column;
			margin-inline-start: 0.5rem;
			font-size: 0.825rem;
		}

		li a {
			display: flex;
			gap: 0.25rem;
			align-items: center;

			max-width: max-content;
			text-decoration: none;

			svg {
				fill: var(--colour-grey-dark);
			}
		}
	}
</style>
