---
import { getCollection } from "astro:content";
import Arrow from "../assets/ArrowIcon.svg";
import { formatDate } from "../utilities/formatDate";

// Latest Thought
const latestThought = {
	id: "thought-1",
	author: "Author",
	handle: "@loading",
	content: "Loading...",
	date: "2009-03-25T13:37",
};

const thoughtDate = formatDate(latestThought.date);

// Your Thoughts
// Initial loading state (before JS runs)
const comments = [
	{
		id: "chat-4",
		author: "Author",
		content: "Loading...",
		date: "2009-03-25T13:37",
	},
	{
		id: "chat-3",
		author: "Author",
		content: "Loading...",
		date: "2009-03-01T09:18",
	},
	{
		id: "chat-1",
		author: "Author",
		content: "Loading...",
		date: "2009-02-04T20:00",
	},
];

// Latest Photo
// Initial loading state (before JS runs)
const loadingPhoto = {
	src: "",
	alt: "",
	caption: "Loading...",
};

// Word Cloud
// Fetch only the "tags" arrays from the blog collection
const blogTags = (await getCollection("blog"))
	.map((entry) => entry.data.tags)
	.filter(Boolean);

// Flatten the array and count occurrences of each tag
const tagCounts = blogTags.flat().reduce(
	(acc: Record<string, number>, tag) => {
		if (typeof tag === "string") {
			acc[tag] = (acc[tag] || 0) + 1;
		}
		return acc;
	},
	{} as Record<string, number>,
);

// Convert to an array of { text, weight } objects
const words = Object.entries(tagCounts)
	.map(([text, count]) => {
		if (count <= 1) return null; // Skip tags with 1 or fewer occurrences

		return {
			text,
			weight: count / 4,
		};
	})
	.filter(Boolean);

// Sort words by weight descending
words.sort((a, b) => {
	if (!a && !b) return 0;
	if (!a) return 1;
	if (!b) return -1;
	return b.weight - a.weight;
});

// Arrange so largest weight is in the middle, smallest at start/end
const sortedWords = new Array(words.length);
let center = Math.floor(words.length / 2);
let left = center - 1;
let right = center + 1;
sortedWords[center] = words[0];
for (let i = 1; i < words.length; i++) {
	if (i % 2 === 1) {
		if (right < words.length) {
			sortedWords[right] = words[i];
			right++;
		}
	} else {
		if (left >= 0) {
			sortedWords[left] = words[i];
			left--;
		}
	}
}
words.splice(0, words.length, ...sortedWords.filter(Boolean));
---

<aside class="sidebar" data-layout="content">
	<search role="search" aria-labelledby="search-label">
		<form>
			<label id="search-label" for="search">search</label>
			<input
				id="search"
				name="search"
				type="search"
				inputmode="search"
				autocomplete="off"
				placeholder="Type here..."
			/>
			<button type="submit">
				<span class="sr-only">Submit</span>
				<Arrow />
			</button>
		</form>
	</search>
	<section class="chat-widget">
		<h2>Your Thoughts</h2>
		{
			comments.map((comment) => {
				const date = formatDate(comment.date);
				return (
					<article>
						<p>
							<span>{comment.author}:</span> {comment.content}
						</p>
						<footer data-layout="content">
							<p>
								<a href={`/thoughts#${comment.id}`}>
									<time datetime={date.html}>{date.datetime}</time> <Arrow />
								</a>
							</p>
						</footer>
					</article>
				);
			})
		}
	</section>
	<section class="social-widget">
		<svg viewBox="0 0 248 204" aria-hidden="true">
			<path
				d="M221.95 51.29c.15 2.17.15 4.34.15 6.53 0 66.73-50.8 143.69-143.69 143.69v-.04c-27.44.04-54.31-7.82-77.41-22.64 3.99.48 8 .72 12.02.73 22.74.02 44.83-7.61 62.72-21.66-21.61-.41-40.56-14.5-47.18-35.07 7.57 1.46 15.37 1.16 22.8-.87-23.56-4.76-40.51-25.46-40.51-49.5v-.64c7.02 3.91 14.88 6.08 22.92 6.32C11.58 63.31 4.74 33.79 18.14 10.71c25.64 31.55 63.47 50.73 104.08 52.76-4.07-17.54 1.49-35.92 14.61-48.25 20.34-19.12 52.33-18.14 71.45 2.19 11.31-2.23 22.15-6.38 32.07-12.26-3.77 11.69-11.66 21.62-22.2 27.93 10.01-1.18 19.79-3.86 29-7.95-6.78 10.16-15.32 19.01-25.2 26.16z"
			></path>
		</svg>
		<h2>Our Thoughts</h2>
		<article>
			<p>{latestThought.content}</p>
			<footer data-layout="content">
				<p>
					<a href={`/thoughts#${latestThought.id}`}>
						{latestThought.author}
						({latestThought.handle})
						<span><Arrow /></span>
					</a>
				</p>
				<p>
					<time datetime={thoughtDate.html}>
						{thoughtDate.datetime}
					</time>
				</p>
				<img src="/images/avatars/default.png" alt="" />
			</footer>
		</article>
	</section>
	<section class="photo-widget">
		<h2>Photo of the Day</h2>
		<figure>
			<img
				src={loadingPhoto.src}
				alt={loadingPhoto.alt}
				loading="lazy"
				height="300"
				width="200"
			/>
			<figcaption>
				{loadingPhoto.caption && <p>{loadingPhoto.caption}</p>}
				<a href="/gallery">Gallery <Arrow /></a>
			</figcaption>
		</figure>
	</section>
	<section class="word-cloud">
		<h2 class="sr-only">Word Cloud</h2>
		<ol role="list">
			{
				words.map((word) => {
					return (
						<li style={`--word-size: ${word?.weight}rem;`}>
							<a href={`?search=${word?.text}`}>{word?.text}</a>
						</li>
					);
				})
			}
		</ol>
	</section>
	<nav class="archives" aria-labelledby="archives-label">
		<!-- TODO: Implement correct hash links -->
		<h2 id="archives-label">Archives</h2>
		<ol role="list">
			<li>
				<a href="/timeline#august">
					<Arrow />
					August 2009
				</a>
			</li>
			<li>
				<a href="/timeline#july">
					<Arrow />
					July 2009
				</a>
			</li>
			<li>
				<a href="/timeline#june">
					<Arrow />
					June 2009
				</a>
			</li>
			<li>
				<a href="/timeline#may">
					<Arrow />
					May 2009
				</a>
			</li>
			<li>
				<a href="/timeline#april">
					<Arrow />
					April 2009
				</a>
			</li>
			<li>
				<a href="/timeline#march">
					<Arrow />
					March 2009
				</a>
			</li>
			<li>
				<a href="/timeline#february">
					<Arrow />
					February 2009
				</a>
			</li>
		</ol>
	</nav>
</aside>

<style>
	.sidebar {
		--gutter: 0;

		padding: 1rem;
		background-color: var(--colour-grey-light);
		flex-grow: 1;

		h2 {
			max-width: 37ch;
			margin-block-end: 0.5em;
			margin-inline: auto;
			font-size: 1rem;
		}

		a:hover,
		a:focus {
			color: var(--colour-focus);
		}
	}

	search {
		background-color: var(--colour-grey-light);

		form {
			display: flex;
			flex-wrap: wrap;
			gap: 1.5rem;
			align-content: center;
			align-items: center;
			max-inline-size: max-content;
			margin-inline: auto;
			padding-block-end: 1rem;

			label {
				font-weight: bold;
				color: var(--colour-white);
				text-shadow: 0 0 1px var(--colour-grey-dark);
				filter: drop-shadow(1px 1px 1px rgba(0 0 0 / 0.2));
			}

			input {
				flex-basis: 1 1 auto;
				width: clamp(10ch, 60%, 25ch);
				padding: revert;
				border: var(--border-form);
				background-color: var(--colour-white);
			}

			button {
				display: flex;
				align-items: center;
				background-color: transparent;
				border: none;
			}

			button:hover svg,
			button:focus svg {
				fill: var(--colour-focus);
			}

			label,
			button {
				margin-block-start: -1px;
			}

			svg {
				margin-inline-start: -0.25rem;
				fill: var(--colour-grey-dark);
			}
		}
	}

	.chat-widget {
		margin-inline: -1rem;
		padding: 1.5rem 1rem;
		background-color: var(--colour-blue-dark);
		color: var(--colour-white);

		h2 {
			color: var(--colour-blue-light);
			margin-block-end: 1rem;
		}

		article {
			min-inline-size: min(100%, 35ch);
			max-inline-size: fit-content;
			margin-inline: auto;
		}

		article + article {
			margin-block-start: 1rem;
			padding-block-start: 1rem;
			border-block-start: 1px solid var(--colour-blue-light);
		}

		article > p {
			font-size: 0.9rem;
			max-inline-size: 39ch;

			span {
				color: var(--colour-blue-light);
				padding-inline-end: 0.25rem;
			}
		}

		p + p {
			margin-block-start: 0.5rem;
		}

		footer {
			--gutter: 0;

			margin-block-start: 0.25rem;
			text-align: end;
			font-size: 0.8rem;

			a {
				display: inline-flex;
				align-items: center;
				justify-content: start;
				gap: 0.25rem;
				text-decoration: none;
				color: var(--colour-blue-light);

				span {
					max-block-size: 1em;
				}
			}
		}
	}

	.social-widget {
		margin-inline: -1rem;
		padding: 1.5rem 1rem;
		background-color: var(--colour-blue-mid);
		color: var(--colour-blue-light);

		& > svg {
			max-inline-size: 1.25rem;
			float: right;
			margin-inline-end: 0.35rem;
		}

		h2 {
			color: inherit;
			margin-block-end: 1rem;
		}

		article {
			max-width: fit-content;
			margin-inline: auto;
			clear: both;
		}

		article > p:first-of-type {
			font-size: 0.9rem;
			max-width: 39ch;
		}

		a:has(span) {
			display: flex;
			align-items: center;
			justify-content: end;
			gap: 0.25rem;

			span {
				max-block-size: 1em;
			}
		}

		footer {
			--gutter: 0;

			display: grid;
			grid-template-columns: 1fr max-content;
			gap: 0 0.5rem;
			margin-block-start: 1rem;
			text-align: end;
			font-size: 0.8rem;

			p:has(a) {
				align-self: end;
			}

			a {
				text-decoration: none;
				color: inherit;
			}

			time {
				color: var(--colour-white);
			}

			img {
				grid-row: 1 / 3;
				grid-column: 2;
				max-inline-size: 2.5rem;
				border: 1px solid var(--colour-border);
			}
		}
	}

	.photo-widget {
		margin-inline: -1rem;
		padding-inline: 1rem;
		padding-block: 1rem;
		background-color: var(--colour-blue-light);
		color: var(--colour-blue-mid);

		h2 {
			color: inherit;
			margin-block-end: 1rem;
		}

		figure {
			max-inline-size: 20rem;
			margin: 0;
			margin-inline: auto;
		}

		img {
			margin-inline: auto;
			border: 2px solid var(--colour-border);
			background-image: url("/images/favicon.png");
			background-repeat: no-repeat;
			background-position: 50%;
		}

		figcaption {
			padding: 0.25rem;
			font-size: 0.8rem;

			p {
				text-align: center;
				margin-block-end: 0.5rem;
			}

			a:has(svg) {
				display: flex;
				align-items: center;
				justify-content: end;
				gap: 0.25rem;
				text-decoration: none;
			}
		}
	}

	.word-cloud {
		padding-block: 2rem;
		background-color: white;
		margin-inline: -1rem;
		padding-inline: 1rem;

		ol {
			max-width: 18rem;
			justify-content: center;
			align-items: center;
			gap: 0 0.5rem;
			margin-inline: auto;
		}

		li {
			font-size: var(--font-size, var(--word-size, 1rem));
			line-height: 1;
			max-height: 1em;
		}

		a {
			text-decoration: none;
			word-break: normal;
		}

		a:hover,
		a:focus-visible {
			color: var(--colour-focus);
		}

		li:has(a:hover),
		li:has(a:focus-visible) {
			--font-size: max(1rem, var(--word-size));
		}
	}

	.archives {
		padding-block: 1rem;

		h2 {
			max-width: 100%;
		}

		ol {
			--gutter: 0;

			flex-direction: column;
			margin-inline-start: 0.5rem;
			font-size: 0.825rem;
		}

		li a {
			display: flex;
			gap: 0.25rem;
			align-items: center;

			max-width: max-content;
			text-decoration: none;

			svg {
				fill: var(--colour-grey-dark);
			}
		}
	}
</style>

<script>
	// Function: Determine max date (based on current date or user input)
	const todayAgo = new Intl.DateTimeFormat("sv-SE")
		.format(new Date().setFullYear(2009))
		.toString(); // Today's date in 2009 (as fallback value)
	const maxDate = sessionStorage.getItem("date") || todayAgo;

	// Function: Search form
	const searchForm = document.querySelector("search form");

	searchForm?.addEventListener("submit", (event) => {
		event.preventDefault();
		const formData = new FormData(event.target as HTMLFormElement);
		const query = formData.get("search")?.toString().trim();
		if (query) {
			window.location.href = `/search?search=${encodeURIComponent(query)}`;
		}
	});

	// Function: Latest chats
	const setLatestChats = (maxDate: string) => {
		// Filter chats to most recent before maxDate
		const filteredChats = chatData
			.filter((chat: any) => chat.date.html <= maxDate)
			.slice(0, 3); // Get the latest 3 chats

		// Update DOM
		const chatContainers = chatContainer?.querySelectorAll("article");

		chatContainers?.forEach((container, index) => {
			// Extract data from API response
			const chat = filteredChats[index];

			// Select DOM nodes to update
			const footer = container
				.querySelector("footer")
				?.cloneNode(true) as HTMLElement; // save footer
			const link = footer?.querySelector("a");
			const date = footer?.querySelector("time");

			if (chat && footer && date && link) {
				container.innerHTML = chat.comment;
				link.setAttribute(
					"href",
					`/thoughts?page=${chat.page}#thought-${chat.id}`,
				);
				date.setAttribute("datetime", chat.date.html);
				date.textContent = chat.date.datetime;
				container.appendChild(footer); // Re-append footer after replacing content
			}
		});
	};

	// Chats initial state
	const chatContainer = document.querySelector(".chat-widget");
	const chatData = await fetch("/api/chat.json")
		.then((res) => res.json())
		.then((data) => data.index);

	setLatestChats(maxDate);

	// Function: Latest thought (Tweet)
	const setLatestThought = (maxDate: string) => {
		// Get most recent thought before maxDate
		const latest = thoughtData.filter(
			(thought: any) => thought.date.html <= maxDate,
		)[0];

		// Update DOM
		if (latest) {
			const thoughtContainer = document.querySelector(".social-widget article");
			const link = thoughtContainer?.querySelector("footer a");
			const date = thoughtContainer?.querySelector("footer time");

			if (link && date && thoughtContainer) {
				thoughtContainer.querySelector("p")!.textContent = latest.comment;
				link.setAttribute(
					"href",
					`/thoughts?page=${latest.page}#thought-${latest.id}`,
				);
				link.childNodes[0].textContent = latest.author; // update author text node
				date.setAttribute("datetime", latest.date.html);
				date.textContent = latest.date.datetime;

				// Update image
				const image = thoughtContainer.querySelector("img");
				image?.setAttribute("src", "/images/avatars/murray.jpg");
				image?.setAttribute(
					"alt",
					"High contrast image of teenage Murray with a large fake, curly moustache superimposed.",
				);
			}
		}
	};

	// Latest thought initial state
	const thoughtData = await fetch("/api/thoughts.json")
		.then((res) => res.json())
		.then((data) => data.index);

	setLatestThought(maxDate);

	// Function: Photo of the day
	const setFeaturedPhoto = (maxDate: string, sessionPhoto?: any) => {
		let photo = {
			src: "",
			alt: "",
			caption: "",
			url: "",
		};

		// Use session image, or fall back to random photo
		if (!sessionPhoto) {
			// Get random photo from albums before maxDate
			const filteredPhotos = photoData.filter(
				(album: any) => album.date <= maxDate && album.images?.length > 0,
			);
			const randomAlbum =
				filteredPhotos[Math.floor(Math.random() * filteredPhotos.length)];
			const randomPhoto =
				randomAlbum?.images?.[
					Math.floor(Math.random() * randomAlbum.images.length)
				];

			// Set photo data
			photo = {
				src: randomPhoto.image.src,
				alt: randomPhoto.alt || "",
				caption: randomPhoto.caption || "",
				url: `/gallery/${randomAlbum.slug}`,
			};
		} else {
			photo = JSON.parse(sessionPhoto);
		}

		// Update DOM
		if (photoContainer) {
			// Capture DOM nodes to update
			const imageElement = photoContainer?.querySelector("img");
			const photoCaption = photoContainer?.querySelector("figcaption > p");
			const galleryLink = photoContainer?.querySelector("figcaption a");

			// Image attributes
			imageElement?.setAttribute("src", photo.src);
			imageElement?.setAttribute("alt", photo.alt || "");

			// Caption
			if (photoCaption) {
				photoCaption.textContent = photo.caption || "";
			}

			// Gallery link
			galleryLink?.setAttribute("href", photo.url);
		}

		// Update session storage
		sessionStorage.setItem("featuredPhoto", JSON.stringify(photo));
	};

	// Photo of the day initial state
	const photoContainer = document.querySelector(".photo-widget figure");
	const photoData = await fetch("/api/photos.json")
		.then((res) => res.json())
		.then((data) => data.index);

	// On initial load, try to retrieve from session (allows it to stay the same between pages)
	const featuredPhoto = sessionStorage.getItem("featuredPhoto");
	setFeaturedPhoto(maxDate, featuredPhoto);

	// Event: Custom date change event (updates date-based sections across sidebar)
	window.addEventListener(
		"dateChange",
		(event: CustomEventInit<{ date: string }>) => {
			if (event.detail?.date) {
				setFeaturedPhoto(event.detail.date);
				setLatestChats(event.detail.date);
				setLatestThought(event.detail.date);
			}
		},
	);
</script>
