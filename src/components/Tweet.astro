---
import { formatDate } from "../utilities/formatDate";

const { comment, author, date: postDate, handle } = Astro.props;

// Format date
const date = formatDate(postDate);

// Set avatar
let avatar;
switch (author.toLowerCase()) {
	case "murray":
		avatar = {
			src: "/images/avatars/murray.jpg",
			alt: "High contrast image of teenage Murray with a large fake, curly moustache superimposed.",
		};
		break;
	case "mike":
		avatar = {
			src: "/images/avatars/mike.jpg",
			alt: "High contrast image of teenage Mike, looking up to the right with hands clasped in front of his face in mock thoughtfulness.",
		};
		break;
	default:
		avatar = {
			src: "/images/avatars/default.png",
			alt: "",
		};
}
---

<aside class="thought" data-layout="content">
	<header>
		<h3>{author} <small>({handle})</small></h3>
		<time datetime={date.html}>{date.datetime}</time>
		<img src={avatar.src} alt={avatar.alt} />
		<svg viewBox="0 0 248 204">
			<path
				d="M221.95 51.29c.15 2.17.15 4.34.15 6.53 0 66.73-50.8 143.69-143.69 143.69v-.04c-27.44.04-54.31-7.82-77.41-22.64 3.99.48 8 .72 12.02.73 22.74.02 44.83-7.61 62.72-21.66-21.61-.41-40.56-14.5-47.18-35.07 7.57 1.46 15.37 1.16 22.8-.87-23.56-4.76-40.51-25.46-40.51-49.5v-.64c7.02 3.91 14.88 6.08 22.92 6.32C11.58 63.31 4.74 33.79 18.14 10.71c25.64 31.55 63.47 50.73 104.08 52.76-4.07-17.54 1.49-35.92 14.61-48.25 20.34-19.12 52.33-18.14 71.45 2.19 11.31-2.23 22.15-6.38 32.07-12.26-3.77 11.69-11.66 21.62-22.2 27.93 10.01-1.18 19.79-3.86 29-7.95-6.78 10.16-15.32 19.01-25.2 26.16z"
			></path>
		</svg>
	</header>
	<Fragment set:html={comment} />
</aside>

<style>
	.thought {
		--gutter: 0.5em;
		--colour-border: var(--colour-blue-light);

		block-size: max-content;
		inline-size: 80%;
		padding: 0.5rem 1rem 1rem;
		border: 2px solid var(--colour-border);
		justify-self: center;

		header {
			display: grid;
			grid-template-columns: max-content 1fr max-content;
			gap: 0 1rem;
			margin-block-end: 0.5rem;

			img {
				grid-column: 1;
				grid-row: 1 / 3;

				max-block-size: 3rem;
				padding: 0.125rem;
				border: 1px solid var(--colour-grey-lighter);
			}

			h3 {
				grid-row: 1;
				font-size: 1.1rem;
				align-self: end;
			}

			small {
				color: var(--colour-text-faded);
			}

			time {
				grid-column: 2;
				text-wrap: balance;
				font-size: 0.75rem;
				color: var(--colour-highlight);
			}

			svg {
				grid-column: 3;
				grid-row: 1 / 3;
				inline-size: 1.5rem;
				align-self: center;
				fill: var(--colour-blue-light);
			}
		}
	}
</style>
