---
import type { CollectionEntry } from "astro:content";
import Global from "./Global.astro";
import Comment from "../components/Comment.astro";
import Pagination from "../components/Pagination.astro";
import { formatDate } from "../utilities/formatDate";

type Props = CollectionEntry<"blog">["data"] & {
	comments: CollectionEntry<"comments">[];
	pagination: {
		prev: { title: string; url: string };
		next: { title: string; url: string };
	};
};

const { title, pubDate, updatedDate, author, comments, pagination } =
	Astro.props;

// Configure dates
const date = formatDate(updatedDate || pubDate);
---

<Global title={title}>
	<Pagination {...pagination} />

	<!-- Article -->
	<article class="blog" data-layout="content">
		<header>
			<h1>{title}</h1>
			<p>by <span>{author}</span></p>
			<p>published <time datetime={date.html}>{date.formatted}</time></p>
		</header>
		<slot />
	</article>

	<!-- Comments -->
	{
		comments.length > 0 && (
			<section class="comments" data-layout="content">
				<h2>Comments ({comments.length})</h2>
				{comments.map((comment) => {
					// Do not show empty comments
					if (!comment.rendered) return null;

					return <Comment {...comment.data} content={comment.rendered.html} />;
				})}
			</section>
		)
	}
	<!-- TODO: Note - i am not replicating the actual comment submission form, because this is an archive -->
</Global>

<style is:global>
	.blog {
		header {
			h1 {
				margin-block-end: 0.25rem;
				font-size: 1.25rem;
				font-weight: 600;
			}

			p {
				line-height: 1.2;
				font-size: 0.825rem;
				color: var(--colour-grey-dark);
				text-wrap: balance;
			}

			p span {
				color: var(--colour-highlight);
			}
		}
	}

	.comments {
		margin-block-start: 3rem;

		h2 {
			font-size: 1.25rem;
		}
	}

	.footnote {
		font-size: 0.75rem;
		color: var(--colour-grey-darker);
	}
</style>
