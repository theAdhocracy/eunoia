---
import "../styles/reset.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
	title: string;
	gutter?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, gutter } = Astro.props;
---

<html lang="en">
	<head>
		<!-- Global Metadata -->
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Primary Meta Tags -->
		<title>Eunoia Blog » {title}</title>
		<meta name="title" content={"Eunoia Blog » " + title} />
		<meta
			name="description"
			content="Archive of the Eunoia Studios blog and website"
		/>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta
			property="og:description"
			content="Archive of the Eunoia Studios blog and website"
		/>
		<!-- <meta property="og:image" content={new URL(image.src, Astro.url)} /> TODO: reinstate with a generic image -->
	</head>

	<body>
		<a href="#main" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main" data-layout="sidebar">
			<div data-layout="content">
				<slot />
			</div>
			<Sidebar />
		</main>
		<Footer />
	</body>
</html>

<style define:vars={{ gutter }}>
	main {
		width: 100%;
		max-width: var(--width-content);
		margin: 0;
		align-self: center;
		padding-block-start: clamp(0.5rem, 5vw + 1rem, 3rem);
	}

	@scope (main[data-layout="sidebar"]) {
		--gutter: 0;
	}

	main > [data-layout="content"] {
		--gutter: var(--gutter);

		padding-inline: clamp(0.5rem, 5vw + 1rem, 3rem);
	}
</style>
