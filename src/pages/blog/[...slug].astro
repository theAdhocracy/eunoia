---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
	const posts = (await getCollection("blog")).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);

	return posts.map((post, index) => {
		// Fetch next and previous posts
		const next = posts[index - 1];
		const prev = posts[index + 1];

		// Merge post data with prev/next info
		const props = { post, prev, next };

		// Generate page
		return {
			params: { slug: post.data.slug || post.id },
			props: props,
		};
	});
}

type Props = {
	post: CollectionEntry<"blog">;
	prev: CollectionEntry<"blog"> | null;
	next: CollectionEntry<"blog"> | null;
};

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

// Comments
const comments = (
	await getCollection("comments", ({ data }) => {
		return data.postID === post.data.id;
	})
).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

// Pagination
const pagination = {
	prev: {
		title: prev ? prev.data.title : "",
		url: prev ? `/blog/${prev.data.slug}` : "",
	},
	next: {
		title: next ? next.data.title : "",
		url: next ? `/blog/${next.data.slug}` : "",
	},
};
---

<BlogPost {...post.data} comments={comments} pagination={pagination}>
	<Content />
</BlogPost>
