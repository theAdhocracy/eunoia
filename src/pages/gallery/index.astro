---
import { getCollection } from "astro:content";
import Global from "../../layouts/Global.astro";
import DateBox from "../../components/DateBox.astro";
import { formatAlbumSlug } from "../../utilities/formatAlbumSlug";

const albums = (await getCollection("albums")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Global title="Gallery" gutter="2rem">
	<h1>Photo Gallery</h1>
	{
		albums.length > 0 && (
			<section class="album-grid">
				<ol role="list">
					{albums.map((album, index) => {
						// Extract album data
						const {
							title,
							author,
							date: datePub,
							thumbnail,
							images,
						} = album.data;

						// Format data
						const filepath = album.id;
						const slug = formatAlbumSlug(filepath);
						const image = `/src/content/albums/${filepath}/${thumbnail}`;

						// Calculate total images
						const total = images?.length ?? 0;

						// Determine country
						const countries = {
							australia: {
								map: "oz.png",
								label: "Australia",
							},
							caribbean: {
								map: "carib.png",
								label: "Caribbean",
							},
							"new-york": {
								map: "na.png",
								label: "New York",
							},
							"new-zealand": {
								map: "kiwi.png",
								label: "New Zealand",
							},
							"se-asia": {
								map: "seasia.png",
								label: "Southeast Asia",
							},
							"south-africa": {
								map: "safriq.png",
								label: "South Africa",
							},
						} as const;
						type CountryKey = keyof typeof countries;
						const country = filepath.split("/")[0] as CountryKey;

						return (
							<li>
								<article>
									<img src={thumbnail ? image : ""} alt={""} />
									<div>
										<header>
											<DateBox date={datePub} />
											<p>{total} photos</p>
											<p>{author}</p>
										</header>
										<h2>
											<a href={`/gallery/${slug}/`}>{title}</a>
										</h2>
										<img
											src={`/images/maps/${countries[country]?.map}`}
											alt={countries[country]?.label}
										/>
									</div>
								</article>
							</li>
						);
					})}
				</ol>
			</section>
		)
	}
</Global>

<style>
	.album-grid {
		margin-block-end: 2rem;

		ol {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
			gap: var(--gutter, 1.25em);
		}

		article {
			display: grid;
			grid-template-columns: min(50%, 10rem) 1fr;
			gap: 0.25rem 1rem;
			position: relative;
			border: var(--border);

			& > img {
				aspect-ratio: 1 / 1;
				inline-size: 100%;
				max-inline-size: 10rem;
				block-size: 100%;
				object-fit: cover;
				border: none;
			}

			div {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				padding-block: 0.5rem;
				padding-inline-end: 0.25rem;

				header {
					display: grid;
					grid-template-columns: max-content 1fr;
					gap: 0 0.5rem;

					time {
						grid-row: span 2;
					}

					p {
						grid-column: 2;
						color: var(--colour-text-faded);
						align-self: start;
					}

					p:first-of-type {
						color: var(--colour-text);
						align-self: end;
					}
				}

				h2 {
					margin-block-start: 0.5rem;
				}

				p {
					font-size: 0.8rem;
				}

				a::before {
					content: "";
					position: absolute;
					inset: 0;
				}

				img {
					inline-size: 3rem;
					margin-block-start: auto;
					align-self: end;
					filter: opacity(0.15);
				}
			}
		}
	}
</style>
