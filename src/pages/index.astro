---
import { getCollection } from "astro:content";
import Global from "../layouts/Global.astro";
import Arrow from "../assets/ArrowIcon.svg";
import { formatDate } from "../utilities/formatDate";

const blogs = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Total pages
const pageCount = Math.ceil(blogs.length / 6);
---

<Global title="Archive">
	<h1>Blog</h1>
	<ol id="blog-posts" role="list">
		{
			blogs.map(async (post, index) => {
				const { slug, title, author, pubDate, description } = post.data;

				// Create formatted date
				const date = formatDate(pubDate);

				// Generate excerpt
				const excerpt =
					post.body
						?.split("\n")[0] // Take first paragraph
						.replaceAll(/<su[p|b]>[0-9]*<\/su[p|b]>/gi, "") // Remove superscript and subscript numbers
						.replaceAll(/<[a-z]*>(.*)<\/[a-z]*>/gi, "$1") // Remove HTML tags
						.slice(0, 180) + "…";

				// Total comments
				const comments = (
					await getCollection("comments", ({ data }) => {
						return data.postID === post.data.id;
					})
				).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

				return (
					<li data-index={index}>
						<header>
							<time datetime={date.html}>{date.short}</time>
							<h2>
								<a href={`/blog/${slug}`}>{title}</a>
							</h2>
							<p>
								Submitted by <span>{author}</span>
							</p>
						</header>
						<p class="excerpt" set:html={description ? description : excerpt} />
						<footer>
							<a href={`/blog/${slug}`}>
								Read more <Arrow />
							</a>
							<p>{comments.length || "0"} Comments</p>
						</footer>
					</li>
				);
			})
		}
	</ol>
	<nav aria-label="Blog pagination" hidden>
		<button class="prev" type="button"><Arrow /> previous</button>
		<ol role="list">
			{
				pageCount > 1 &&
					Array.from({ length: pageCount }).map((_, index) => (
						<li>
							<button type="button">
								<span class="sr-only">Page </span>
								{index + 1}
							</button>
						</li>
					))
			}
		</ol>
		<button class="next" type="button">next <Arrow /></button>
	</nav>
</Global>

<script>
	// Function: initialise pagination
	const initPagination = (
		pagination: Element | null,
		posts: NodeListOf<Element>
	) => {
		if (!pagination) return false;

		const currentPage =
			new URL(window.location.href).searchParams.get("page") || "1";
		const pageIndex = parseInt(currentPage) - 1;

		// Show pagination
		pagination.removeAttribute("hidden");

		// Set aria-current on current page button
		const pageButtons = pagination.querySelectorAll(
			"ol button"
		) as NodeListOf<HTMLButtonElement>;
		pageButtons.forEach((button, index) => {
			if (index === pageIndex) {
				button.setAttribute("aria-current", "true");
			}
		});

		// Hide all posts except the chosen page
		posts.forEach((post, postIndex) => {
			if (!(postIndex >= pageIndex * 6 && postIndex < (pageIndex + 1) * 6)) {
				post.setAttribute("hidden", "");
			}
		});

		return true;
	};

	// Function: update URL with selected page
	const paginateURL = (pageIndex: number) => {
		const url = new URL(window.location.href);
		url.searchParams.set("page", (pageIndex + 1).toString());
		window.history.replaceState({}, "", url.toString());
	};

	// Get elements
	const posts = document.querySelectorAll("#blog-posts > li");
	const pagination = document.querySelector(
		"nav[aria-label='Blog pagination']"
	);

	// Initiate pagination
	const paginationInitiated = initPagination(pagination, posts);

	// Get pagination buttons
	const pageButtons = pagination?.querySelectorAll(
		"ol button"
	) as NodeListOf<HTMLButtonElement>;
	const prevButton = pagination?.querySelector(".prev");
	const nextButton = pagination?.querySelector(".next");

	// Function: pagination (page) buttons
	if (paginationInitiated && pageButtons) {
		pageButtons.forEach((button, pageIndex) => {
			button.addEventListener("click", () => {
				// Update aria-current
				pageButtons.forEach((btn) => btn.removeAttribute("aria-current"));
				button.setAttribute("aria-current", "true");

				// Show/hide posts
				posts.forEach((post, postIndex) => {
					if (postIndex >= pageIndex * 6 && postIndex < (pageIndex + 1) * 6) {
						post.removeAttribute("hidden");
					} else {
						post.setAttribute("hidden", "");
					}
				});

				// Update URL
				paginateURL(pageIndex);
			});
		});
	}

	// Function: previous button
	prevButton?.addEventListener("click", () => {
		const currentPageButton = document.querySelector(
			"ol button[aria-current='true']"
		);
		if (!currentPageButton) return;

		const currentPageIndex = Array.from(pageButtons || []).indexOf(
			currentPageButton as HTMLButtonElement
		);
		if (currentPageIndex > 0) {
			pageButtons?.[currentPageIndex - 1]?.click();
		}
	});

	// Function: next button
	nextButton?.addEventListener("click", () => {
		const currentPageButton = document.querySelector(
			"ol button[aria-current='true']"
		);
		if (!currentPageButton) return;

		const currentPageIndex = Array.from(pageButtons || []).indexOf(
			currentPageButton as HTMLButtonElement
		);

		if (currentPageIndex < pageButtons.length - 1) {
			pageButtons?.[currentPageIndex + 1]?.click();
		}
	});
</script>

<style>
	ol {
		flex-direction: column;

		time {
			display: flex;
			inline-size: 4em;
			aspect-ratio: 1 / 1;
			padding-inline: 0.8rem;
			background-color: var(--colour-grey-light);
			border-radius: 0.25rem;

			place-items: center;
			text-align: center;
			text-transform: lowercase;
			font-size: 0.8rem;
			line-height: 1.2;
		}

		header {
			display: grid;
			grid-template-columns: max-content 1fr;
			gap: 0 1.5rem;

			time {
				grid-row: span 2;
			}
		}

		a {
			text-decoration: none;
		}

		a:hover,
		a:focus {
			color: var(--colour-focus);
		}

		h2 {
			align-self: end;
			line-height: 1;
		}

		p {
			font-size: 0.8rem;
		}

		p span {
			color: var(--colour-blue-mid);
		}

		.excerpt {
			margin-block-end: 1rem;
			margin-inline-start: 4.675rem;
			font-size: 1rem;
			line-height: 1.3;
		}

		footer {
			display: flex;
			flex-wrap: wrap;
			gap: 0 1rem;
			justify-content: space-between;
			font-size: 0.8rem;
			margin-inline-start: 4.675rem;

			a {
				display: flex;
				align-items: center;
			}
		}
	}

	nav {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		margin-block: 1rem 2rem;

		ol {
			--gutter: 0.5rem;
			flex-direction: row;
			justify-content: center;

			button {
				width: 2rem;
				padding: 0.5rem;
				aspect-ratio: 1 / 1;
				background-color: var(--colour-grey-light);
				border: none;
				color: var(--colour-text);

				&:hover,
				&:focus-visible {
					background-color: var(--colour-focus);
					color: var(--colour-background);
				}

				&[aria-current="true"] {
					color: var(--colour-blue-mid);
				}
			}
		}

		.prev,
		.next {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			height: 2rem;
			background-color: transparent;
			border: none;
			color: var(--colour-text);
			white-space: nowrap;
			font-size: 0.9rem;

			&:hover,
			&:focus-visible {
				color: var(--colour-focus);
			}
		}

		.prev svg {
			transform: rotate(180deg);
		}
	}
</style>
